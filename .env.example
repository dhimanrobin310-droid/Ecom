# Backend API base URL for frontend
VITE_API_URL=https://ecom-1hqx.onrender.com

# Frontend URL for CORS
CORS_ORIGIN=https://ecom-alpha-beryl.vercel.app

# MongoDB Atlas connection string used by the backend.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/Multikart?retryWrites=true&w=majority

# Use a long, randomly generated value.
JWT_SECRET=replace-with-a-long-random-secret

# Create a Vercel Blob store and copy its read/write token here (if using Vercel Blob for images).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

